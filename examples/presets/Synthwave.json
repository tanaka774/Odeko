		{
			"id": "sc-synth-custom-1",
			"name": "Custom HTML",
			"path": "",
			"icon_path": null,
			"icon_type": "widget",
			"widget_type": "custom",
			"widget_config": {
				"appearance": {
					"backgroundColor": "#1a0b2e",
					"backgroundOpacity": 0.7,
					"backdropBlur": 10,
					"borderRadius": 12,
					"textColor": "#fdf4ff",
					"borderColor": "#f0abfc",
					"borderWidth": 1,
					"shadowBlur": 30,
					"shadowColor": "#d946ef",
					"shadowOpacity": 0.5,
					"shadowOffsetY": 0,
					"gradientColor": "#3b0764",
					"gradientAngle": 160,
					"fontFamily": "Orbitron, system-ui",
					"padding": 12
				},
				"content": "<!--\n\tVisualizer: an animated equalizer and orbiting particles in your theme\n\tcolors, for decoration. It stops drawing while the canvas is hidden\n\t(odeko.on('pause'/'resume')), so it costs nothing in the background.\n-->\n<style>\n\t:root {\n\t\t--a: #f0abfc;\n\t\t--b: #fde68a;\n\t}\n\t* {\n\t\tbox-sizing: border-box;\n\t}\n\tbody {\n\t\theight: 100vh;\n\t\toverflow: hidden;\n\t}\n\tcanvas {\n\t\tdisplay: block;\n\t\twidth: 100%;\n\t\theight: 100%;\n\t}\n</style>\n<canvas></canvas>\n<script>\n\tconst canvas = document.querySelector('canvas');\n\tconst ctx = canvas.getContext('2d');\n\tconst css = getComputedStyle(document.documentElement);\n\tconst colorA = css.getPropertyValue('--a').trim();\n\tconst colorB = css.getPropertyValue('--b').trim();\n\tconst BARS = 32;\n\tconst levels = Array(BARS).fill(0);\n\tlet raf = 0;\n\n\tfunction frame(now) {\n\t\traf = requestAnimationFrame(frame);\n\t\tconst ratio = window.devicePixelRatio || 1;\n\t\tconst w = canvas.clientWidth;\n\t\tconst h = canvas.clientHeight;\n\t\tif (canvas.width !== w * ratio || canvas.height !== h * ratio) {\n\t\t\tcanvas.width = w * ratio;\n\t\t\tcanvas.height = h * ratio;\n\t\t\tctx.setTransform(ratio, 0, 0, ratio, 0, 0);\n\t\t}\n\t\tctx.clearRect(0, 0, w, h);\n\t\tconst t = now / 1000;\n\t\tconst gradient = ctx.createLinearGradient(0, h, 0, 0);\n\t\tgradient.addColorStop(0, colorB);\n\t\tgradient.addColorStop(1, colorA);\n\t\tconst gap = 3;\n\t\tconst barWidth = (w - gap * (BARS - 1)) / BARS;\n\t\tfor (let i = 0; i < BARS; i++) {\n\t\t\tconst beat =\n\t\t\t\tMath.max(0, Math.sin(t * 2.1 + i * 0.35)) * 0.5 +\n\t\t\t\tMath.max(0, Math.sin(t * 3.7 - i * 0.6)) * 0.35;\n\t\t\tconst target = 0.12 + beat * (0.6 + 0.4 * Math.sin(i * 0.9 + t * 0.4) ** 2);\n\t\t\tlevels[i] += (target - levels[i]) * 0.18;\n\t\t\tconst bh = levels[i] * h * 0.85;\n\t\t\tctx.fillStyle = gradient;\n\t\t\tctx.globalAlpha = 0.9;\n\t\t\tctx.beginPath();\n\t\t\tctx.roundRect(i * (barWidth + gap), h - bh, barWidth, bh, Math.min(4, barWidth / 2));\n\t\t\tctx.fill();\n\t\t\tctx.globalAlpha = 0.18;\n\t\t\tctx.fillRect(i * (barWidth + gap), h - bh - 6, barWidth, 2);\n\t\t}\n\t\tctx.globalAlpha = 1;\n\t\tfor (let p = 0; p < 24; p++) {\n\t\t\tconst angle = t * (0.3 + (p % 5) * 0.05) + p * 1.7;\n\t\t\tconst r = Math.min(w, h) * (0.18 + (p % 7) * 0.03);\n\t\t\tconst x = w / 2 + Math.cos(angle) * r * 1.6;\n\t\t\tconst y = h * 0.35 + Math.sin(angle) * r * 0.5;\n\t\t\tctx.fillStyle = p % 2 ? colorA : colorB;\n\t\t\tctx.globalAlpha = 0.35 + 0.35 * Math.sin(t * 2 + p);\n\t\t\tctx.beginPath();\n\t\t\tctx.arc(x, y, 1.5 + (p % 3), 0, Math.PI * 2);\n\t\t\tctx.fill();\n\t\t}\n\t\tctx.globalAlpha = 1;\n\t}\n\n\todeko.on('pause', () => cancelAnimationFrame(raf));\n\todeko.on('resume', () => {\n\t\tcancelAnimationFrame(raf);\n\t\traf = requestAnimationFrame(frame);\n\t});\n\traf = requestAnimationFrame(frame);\n</script>\n",
				"scripts": true,
				"file": null,
				"watch": false
			},
