			{
				"id": "layer-sc-37",
				"name": "Sunset grid",
				"enabled": true,
				"opacity": 1,
				"blend": "normal",
				"placement": "below",
				"type": "shader",
				"source": "// Synthwave sun and grid\nvoid mainImage(out vec4 o, in vec2 f){\n\tvec2 uv=(f-0.5*iResolution.xy)/iResolution.y;\n\tvec3 sky=mix(vec3(0.98,0.35,0.55),vec3(0.08,0.02,0.18),smoothstep(-0.05,0.5,uv.y));\n\tvec2 sp=uv-vec2(0.0,0.12);float sun=smoothstep(0.26,0.255,length(sp));\n\tfloat bands=step(0.0,sin((uv.y-iTime*0.02)*90.0)+ (uv.y-0.05)*14.0);\n\tsun*=mix(1.0,bands,step(uv.y,0.12));\n\tvec3 col=sky+sun*mix(vec3(1.0,0.85,0.3),vec3(1.0,0.2,0.6),smoothstep(0.35,-0.1,uv.y));\n\tif(uv.y<-0.05){float d=-0.05-uv.y;vec2 g=vec2(uv.x/d,1.0/d+iTime*2.0)*0.6;vec2 l=abs(fract(g)-0.5);float line=smoothstep(0.08*d*6.0+0.02,0.0,min(l.x,l.y));\n\t\tcol=mix(vec3(0.05,0.0,0.12),vec3(1.0,0.2,0.8),line)+vec3(0.6,0.1,0.5)*exp(-d*12.0);}\n\tcol+=vec3(1.0,0.4,0.9)*odHoverGlow(f,60.0)*0.5+vec3(1.0)*odPulseRing(f,700.0,24.0,1.4)*0.5;\n\to=vec4(col,1.0);}",
