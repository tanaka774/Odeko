		{
			"id": "sc-desk-countdown",
			"name": "Custom HTML",
			"path": "",
			"icon_path": null,
			"icon_type": "widget",
			"widget_type": "custom",
			"widget_config": {
				"appearance": {
					"backgroundColor": "#ffffff",
					"backgroundOpacity": 0.08,
					"backdropBlur": 18,
					"borderColor": "rgba(255, 255, 255, 0.18)",
					"borderWidth": 1,
					"borderRadius": 18
				},
				"content": "<!--\n\tCountdown: days until an event. Click the widget to edit the name and\n\tdate; both are saved with odeko.storage.\n-->\n<style>\n\t:root {\n\t\t--accent: #7dd3fc;\n\t}\n\t* {\n\t\tbox-sizing: border-box;\n\t}\n\tbody {\n\t\tdisplay: grid;\n\t\tplace-items: center;\n\t\theight: 100vh;\n\t\ttext-align: center;\n\t\tpadding: 8px;\n\t}\n\t#view {\n\t\tcursor: pointer;\n\t}\n\t#days {\n\t\tfont-size: 3.4em;\n\t\tfont-weight: 800;\n\t\tline-height: 1;\n\t\tcolor: var(--accent);\n\t\tfont-variant-numeric: tabular-nums;\n\t}\n\t#unit {\n\t\tfont-size: 0.85em;\n\t\topacity: 0.6;\n\t\tmargin-top: 2px;\n\t}\n\t#name {\n\t\tfont-size: 1.1em;\n\t\tfont-weight: 600;\n\t\tmargin-top: 8px;\n\t}\n\t#date {\n\t\tfont-size: 0.75em;\n\t\topacity: 0.5;\n\t}\n\tform {\n\t\tdisplay: none;\n\t\tflex-direction: column;\n\t\tgap: 6px;\n\t\twidth: 100%;\n\t\tmax-width: 260px;\n\t}\n\tform.open {\n\t\tdisplay: flex;\n\t}\n\tform.open + #view,\n\t#view.hidden {\n\t\tdisplay: none;\n\t}\n\tinput,\n\tbutton {\n\t\tfont: inherit;\n\t\tpadding: 4px 8px;\n\t\tborder-radius: 6px;\n\t\tborder: 1px solid rgba(255, 255, 255, 0.25);\n\t\tbackground: rgba(0, 0, 0, 0.3);\n\t\tcolor: inherit;\n\t}\n\tbutton {\n\t\tcursor: pointer;\n\t}\n</style>\n<form id=\"form\">\n\t<input id=\"nameInput\" type=\"text\" placeholder=\"Event\" aria-label=\"Event name\" />\n\t<input id=\"dateInput\" type=\"date\" aria-label=\"Event date\" />\n\t<button type=\"submit\">Save</button>\n</form>\n<div id=\"view\" title=\"Click to edit\">\n\t<div id=\"days\">–</div>\n\t<div id=\"unit\">days</div>\n\t<div id=\"name\"></div>\n\t<div id=\"date\"></div>\n</div>\n<script>\n\tconst form = document.getElementById('form');\n\tconst view = document.getElementById('view');\n\tlet event = null;\n\n\tfunction daysUntil(iso) {\n\t\tconst [y, m, d] = iso.split('-').map(Number);\n\t\tconst target = new Date(y, m - 1, d);\n\t\tconst now = new Date();\n\t\tconst today = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n\t\treturn Math.round((target - today) / 86400000);\n\t}\n\n\tfunction render() {\n\t\tif (!event) {\n\t\t\tdocument.getElementById('days').textContent = '+';\n\t\t\tdocument.getElementById('unit').textContent = 'click to set an event';\n\t\t\tdocument.getElementById('name').textContent = '';\n\t\t\tdocument.getElementById('date').textContent = '';\n\t\t\treturn;\n\t\t}\n\t\tconst days = daysUntil(event.date);\n\t\tdocument.getElementById('days').textContent = Math.abs(days);\n\t\tdocument.getElementById('unit').textContent =\n\t\t\tdays === 0\n\t\t\t\t? 'today!'\n\t\t\t\t: days > 0\n\t\t\t\t\t? days === 1\n\t\t\t\t\t\t? 'day to go'\n\t\t\t\t\t\t: 'days to go'\n\t\t\t\t\t: days === -1\n\t\t\t\t\t\t? 'day ago'\n\t\t\t\t\t\t: 'days ago';\n\t\tdocument.getElementById('name').textContent = event.name;\n\t\tconst [y, m, d] = event.date.split('-').map(Number);\n\t\tdocument.getElementById('date').textContent = new Date(y, m - 1, d).toLocaleDateString(\n\t\t\tundefined,\n\t\t\t{\n\t\t\t\tweekday: 'short',\n\t\t\t\tyear: 'numeric',\n\t\t\t\tmonth: 'short',\n\t\t\t\tday: 'numeric'\n\t\t\t}\n\t\t);\n\t}\n\n\tview.addEventListener('click', () => {\n\t\tdocument.getElementById('nameInput').value = event?.name ?? '';\n\t\tdocument.getElementById('dateInput').value = event?.date ?? '';\n\t\tform.classList.add('open');\n\t\tdocument.getElementById('nameInput').focus();\n\t});\n\n\tform.addEventListener('submit', (submit) => {\n\t\tsubmit.preventDefault();\n\t\tconst name = document.getElementById('nameInput').value.trim();\n\t\tconst date = document.getElementById('dateInput').value;\n\t\tif (date) {\n\t\t\tevent = { name: name || 'Event', date };\n\t\t\todeko.storage.set('event', event);\n\t\t}\n\t\tform.classList.remove('open');\n\t\trender();\n\t});\n\n\todeko.storage.get('event').then((saved) => {\n\t\tevent = saved;\n\t\trender();\n\t});\n\tsetInterval(render, 60000);\n</script>\n",
