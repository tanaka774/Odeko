		{
			"id": "sc-desk-custom-1",
			"name": "Custom HTML",
			"path": "",
			"icon_path": null,
			"icon_type": "widget",
			"widget_type": "custom",
			"widget_config": {
				"appearance": {
					"backgroundColor": "#ffffff",
					"backgroundOpacity": 0.08,
					"backdropBlur": 18,
					"borderColor": "rgba(255, 255, 255, 0.18)",
					"borderWidth": 1,
					"borderRadius": 18,
					"fontSize": 18
				},
				"content": "<style>\n\tbody { padding: 8px 12px; }\n\t.row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }\n\t.row:last-child { border-bottom: none; }\n\t.city { opacity: 0.65; }\n\t.time { font-weight: 600; font-variant-numeric: tabular-nums; }\n</style>\n<div id=\"rows\"></div>\n<script>\n\tconst ZONES = [\n\t\t['Tokyo', 'Asia/Tokyo'],\n\t\t['London', 'Europe/London'],\n\t\t['New York', 'America/New_York']\n\t];\n\tconst rows = ZONES.map(([city, zone]) => {\n\t\tconst row = document.createElement('div');\n\t\trow.className = 'row';\n\t\trow.innerHTML = `<span class=\"city\">${city}</span><span class=\"time\"></span>`;\n\t\tdocument.getElementById('rows').append(row);\n\t\treturn { zone, el: row.querySelector('.time') };\n\t});\n\tfunction render() {\n\t\tfor (const { zone, el } of rows) {\n\t\t\tel.textContent = new Date().toLocaleTimeString('en-GB', {\n\t\t\t\thour: '2-digit',\n\t\t\t\tminute: '2-digit',\n\t\t\t\tsecond: '2-digit',\n\t\t\t\ttimeZone: zone\n\t\t\t});\n\t\t}\n\t}\n\tsetInterval(render, 1000);\n\trender();\n</script>\n",
