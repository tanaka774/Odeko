		{
			"id": "sc-hack-deck",
			"name": "Custom HTML",
			"path": "",
			"icon_path": null,
			"icon_type": "widget",
			"widget_type": "custom",
			"widget_config": {
				"appearance": {
					"backgroundColor": "#000000",
					"backgroundOpacity": 0.85,
					"borderColor": "#22c55e",
					"borderWidth": 1,
					"borderRadius": 0,
					"textColor": "#4ade80",
					"fontFamily": "VT323, system-ui",
					"fontSize": 22,
					"padding": 0
				},
				"content": "<!--\n\tCommand Deck: one widget that uses everything a Custom HTML page can do.\n\t- odeko.fetch: live weather (Open-Meteo) and Hacker News top stories\n\t- odeko.storage: focus timer, notes, city and tab survive restarts\n\t- a library from a CDN (Chart.js), cached for offline use\n\t- canvas animation, tabs, keyboard shortcuts, links that open in the browser\n\tSuggested size: 460 x 400 or larger.\n-->\n<style>\n\t:root {\n\t\t--accent: #22c55e;\n\t\t--accent-2: #4ade80;\n\t\t--glass: rgba(255, 255, 255, 0.06);\n\t\t--line: rgba(255, 255, 255, 0.1);\n\t\t--muted: rgba(255, 255, 255, 0.55);\n\t}\n\t* { box-sizing: border-box; }\n\tbody {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\theight: 100vh;\n\t\toverflow: hidden;\n\t\tfont-size: 13px;\n\t}\n\t#aurora {\n\t\tposition: fixed;\n\t\tinset: 0;\n\t\tz-index: -1;\n\t\twidth: 100%;\n\t\theight: 100%;\n\t}\n\theader {\n\t\tdisplay: flex;\n\t\talign-items: baseline;\n\t\tgap: 8px;\n\t\tpadding: 6px 10px 0;\n\t}\n\t#clock {\n\t\tfont-size: 2.2em;\n\t\tfont-weight: 800;\n\t\tletter-spacing: -0.02em;\n\t\tfont-variant-numeric: tabular-nums;\n\t\tbackground: linear-gradient(90deg, #fff, var(--accent-2));\n\t\t-webkit-background-clip: text;\n\t\tbackground-clip: text;\n\t\tcolor: transparent;\n\t}\n\t#date { color: var(--muted); }\n\t#now {\n\t\tmargin-left: auto;\n\t\ttext-align: right;\n\t\tline-height: 1.2;\n\t}\n\t#now b { font-size: 1.4em; }\n\tnav {\n\t\tdisplay: flex;\n\t\tgap: 2px;\n\t\tpadding: 6px 10px 4px;\n\t}\n\tnav button {\n\t\tflex: 1;\n\t\tpadding: 4px 0;\n\t\tborder: 1px solid var(--line);\n\t\tborder-radius: 6px;\n\t\tbackground: transparent;\n\t\tcolor: var(--muted);\n\t\tfont: inherit;\n\t\tcursor: pointer;\n\t\ttransition: background 0.2s, color 0.2s;\n\t}\n\tnav button.active {\n\t\tbackground: var(--glass);\n\t\tcolor: #fff;\n\t\tborder-color: color-mix(in srgb, var(--accent) 70%, transparent);\n\t}\n\tnav kbd { opacity: 0.5; font-size: 0.8em; }\n\tmain { flex: 1; min-height: 0; position: relative; }\n\tsection {\n\t\tposition: absolute;\n\t\tinset: 0;\n\t\tpadding: 4px 10px 8px;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 6px;\n\t\topacity: 0;\n\t\ttransform: translateY(6px);\n\t\tpointer-events: none;\n\t\ttransition: opacity 0.25s, transform 0.25s;\n\t}\n\tsection.active { opacity: 1; transform: none; pointer-events: auto; }\n\t.card {\n\t\tbackground: var(--glass);\n\t\tborder: 1px solid var(--line);\n\t\tborder-radius: 10px;\n\t\tpadding: 6px 8px;\n\t}\n\t.row { display: flex; align-items: center; gap: 6px; }\n\t.muted { color: var(--muted); }\n\t.err { color: #fca5a5; }\n\tinput, textarea {\n\t\tfont: inherit;\n\t\tcolor: inherit;\n\t\tbackground: rgba(0, 0, 0, 0.3);\n\t\tborder: 1px solid var(--line);\n\t\tborder-radius: 6px;\n\t\tpadding: 3px 6px;\n\t}\n\tbutton.small {\n\t\tfont: inherit;\n\t\tcolor: inherit;\n\t\tbackground: var(--glass);\n\t\tborder: 1px solid var(--line);\n\t\tborder-radius: 6px;\n\t\tpadding: 2px 8px;\n\t\tcursor: pointer;\n\t}\n\tbutton.small:hover { border-color: var(--accent); }\n\n\t/* Weather */\n\t#chart-box { flex: 1; min-height: 0; position: relative; }\n\t#forecast { display: flex; justify-content: space-between; }\n\t#forecast div { text-align: center; }\n\t#forecast b { display: block; }\n\n\t/* Focus */\n\t#focus { align-items: center; justify-content: center; }\n\t#ring { width: 150px; height: 150px; }\n\t#ring circle { fill: none; stroke-width: 10; }\n\t#ring .track { stroke: var(--line); }\n\t#ring .bar {\n\t\tstroke: url(#grad);\n\t\tstroke-linecap: round;\n\t\ttransform: rotate(-90deg);\n\t\ttransform-origin: 50% 50%;\n\t\ttransition: stroke-dashoffset 0.9s linear;\n\t}\n\t#ring text {\n\t\tfill: #fff;\n\t\tfont-size: 24px;\n\t\tfont-weight: 700;\n\t\ttext-anchor: middle;\n\t\tdominant-baseline: middle;\n\t\tfont-variant-numeric: tabular-nums;\n\t}\n\t#streak { display: flex; gap: 3px; }\n\t#streak i {\n\t\twidth: 10px;\n\t\theight: 10px;\n\t\tborder-radius: 3px;\n\t\tbackground: var(--line);\n\t}\n\t#streak i.on { background: linear-gradient(135deg, var(--accent), var(--accent-2)); }\n\n\t/* News */\n\t#news { overflow-y: auto; gap: 4px; scrollbar-width: thin; scrollbar-color: rgba(255, 255, 255, 0.2) transparent; }\n\t#news a {\n\t\tdisplay: flex;\n\t\tgap: 8px;\n\t\tpadding: 5px 8px;\n\t\tborder-radius: 8px;\n\t\tcolor: inherit;\n\t\ttext-decoration: none;\n\t\tbackground: var(--glass);\n\t\tborder: 1px solid transparent;\n\t}\n\t#news a:hover { border-color: var(--accent); }\n\t#news .score {\n\t\tmin-width: 3em;\n\t\tcolor: var(--accent-2);\n\t\tfont-weight: 700;\n\t\tfont-variant-numeric: tabular-nums;\n\t}\n\t#news .title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n\t/* Notes */\n\t#notes textarea { flex: 1; resize: none; line-height: 1.5; }\n</style>\n\n<canvas id=\"aurora\"></canvas>\n\n<header>\n\t<div id=\"clock\">--:--</div>\n\t<div id=\"date\"></div>\n\t<div id=\"now\"><b id=\"now-temp\">–</b><br /><span id=\"now-text\" class=\"muted\"></span></div>\n</header>\n\n<nav id=\"tabs\">\n\t<button data-tab=\"weather\">Weather <kbd>1</kbd></button>\n\t<button data-tab=\"focus\">Focus <kbd>2</kbd></button>\n\t<button data-tab=\"news\">News <kbd>3</kbd></button>\n\t<button data-tab=\"notes\">Notes <kbd>4</kbd></button>\n</nav>\n\n<main>\n\t<section id=\"weather\">\n\t\t<div class=\"row\">\n\t\t\t<input id=\"city\" aria-label=\"City\" style=\"width: 9em\" />\n\t\t\t<span id=\"place\" class=\"muted\"></span>\n\t\t\t<span id=\"weather-err\" class=\"err\"></span>\n\t\t</div>\n\t\t<div id=\"chart-box\" class=\"card\"><canvas id=\"chart\"></canvas></div>\n\t\t<div id=\"forecast\" class=\"card\"></div>\n\t</section>\n\n\t<section id=\"focus\">\n\t\t<svg id=\"ring\" viewBox=\"0 0 160 160\">\n\t\t\t<defs>\n\t\t\t\t<linearGradient id=\"grad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n\t\t\t\t\t<stop offset=\"0\" stop-color=\"#8b5cf6\" />\n\t\t\t\t\t<stop offset=\"1\" stop-color=\"#22d3ee\" />\n\t\t\t\t</linearGradient>\n\t\t\t</defs>\n\t\t\t<circle class=\"track\" cx=\"80\" cy=\"80\" r=\"66\" />\n\t\t\t<circle class=\"bar\" id=\"bar\" cx=\"80\" cy=\"80\" r=\"66\" />\n\t\t\t<text id=\"left\" x=\"80\" y=\"80\">25:00</text>\n\t\t</svg>\n\t\t<div class=\"row\">\n\t\t\t<button class=\"small\" id=\"start\">Focus 25</button>\n\t\t\t<button class=\"small\" id=\"short\">Break 5</button>\n\t\t\t<button class=\"small\" id=\"stop\">Stop</button>\n\t\t</div>\n\t\t<div class=\"row muted\">Today <div id=\"streak\"></div></div>\n\t</section>\n\n\t<section id=\"news\">\n\t\t<div class=\"row\"><span class=\"muted\">Hacker News top stories</span><span id=\"news-err\" class=\"err\"></span></div>\n\t\t<div id=\"stories\" class=\"row\" style=\"flex-direction: column; align-items: stretch; gap: 4px\"></div>\n\t</section>\n\n\t<section id=\"notes\">\n\t\t<textarea id=\"note\" aria-label=\"Notes\"></textarea>\n\t\t<div class=\"row muted\"><span id=\"saved\">Saved</span><span style=\"margin-left: auto\">Ctrl+S saves now</span></div>\n\t</section>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n<script>\n\tconst $ = (id) => document.getElementById(id);\n\tconst store = odeko.storage;\n\n\t// ── Aurora background: a small canvas animation that pauses with the canvas.\n\tconst aurora = (() => {\n\t\tconst canvas = $('aurora');\n\t\tconst ctx = canvas.getContext('2d');\n\t\tconst blobs = [\n\t\t\t{ hue: 265, x: 0.2, y: 0.3, r: 0.55, s: 0.00021 },\n\t\t\t{ hue: 190, x: 0.8, y: 0.6, r: 0.5, s: 0.00017 },\n\t\t\t{ hue: 320, x: 0.5, y: 0.9, r: 0.45, s: 0.00013 }\n\t\t];\n\t\tlet raf = 0;\n\t\tfunction draw(t) {\n\t\t\tconst w = (canvas.width = innerWidth);\n\t\t\tconst h = (canvas.height = innerHeight);\n\t\t\tctx.clearRect(0, 0, w, h);\n\t\t\tctx.globalCompositeOperation = 'lighter';\n\t\t\tfor (const b of blobs) {\n\t\t\t\tconst x = (b.x + Math.sin(t * b.s * 6) * 0.15) * w;\n\t\t\t\tconst y = (b.y + Math.cos(t * b.s * 5) * 0.12) * h;\n\t\t\t\tconst r = b.r * Math.max(w, h);\n\t\t\t\tconst g = ctx.createRadialGradient(x, y, 0, x, y, r);\n\t\t\t\tg.addColorStop(0, `hsla(${b.hue}, 80%, 55%, 0.22)`);\n\t\t\t\tg.addColorStop(1, 'transparent');\n\t\t\t\tctx.fillStyle = g;\n\t\t\t\tctx.fillRect(0, 0, w, h);\n\t\t\t}\n\t\t\traf = requestAnimationFrame(draw);\n\t\t}\n\t\treturn {\n\t\t\tstart: () => (raf ||= requestAnimationFrame(draw)),\n\t\t\tstop: () => {\n\t\t\t\tcancelAnimationFrame(raf);\n\t\t\t\traf = 0;\n\t\t\t}\n\t\t};\n\t})();\n\taurora.start();\n\todeko.on('pause', aurora.stop);\n\todeko.on('resume', aurora.start);\n\n\t// ── Clock\n\tfunction tickClock() {\n\t\tconst now = new Date();\n\t\t$('clock').textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });\n\t\t$('date').textContent = now.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });\n\t}\n\ttickClock();\n\tsetInterval(tickClock, 1000);\n\n\t// ── Tabs (keys 1-4), remembered across restarts\n\tconst TABS = ['weather', 'focus', 'news', 'notes'];\n\tfunction showTab(name) {\n\t\tfor (const tab of TABS) {\n\t\t\t$(tab).classList.toggle('active', tab === name);\n\t\t\tdocument.querySelector(`[data-tab=\"${tab}\"]`).classList.toggle('active', tab === name);\n\t\t}\n\t\tstore.set('tab', name);\n\t\tif (name === 'news') loadNews();\n\t}\n\t$('tabs').addEventListener('click', (event) => {\n\t\tconst tab = event.target.closest('button')?.dataset.tab;\n\t\tif (tab) showTab(tab);\n\t});\n\taddEventListener('keydown', (event) => {\n\t\tif (event.target.matches('input, textarea')) {\n\t\t\tif ((event.ctrlKey || event.metaKey) && event.key === 's') {\n\t\t\t\tevent.preventDefault();\n\t\t\t\tsaveNote();\n\t\t\t}\n\t\t\treturn;\n\t\t}\n\t\tconst index = Number(event.key) - 1;\n\t\tif (TABS[index]) {\n\t\t\tevent.preventDefault();\n\t\t\tshowTab(TABS[index]);\n\t\t}\n\t});\n\n\t// ── Network helper with one retry\n\tasync function getJson(url, retries = 1) {\n\t\ttry {\n\t\t\tconst { status, body } = await odeko.fetch(url);\n\t\t\tif (status !== 200) throw new Error(`HTTP ${status}`);\n\t\t\treturn JSON.parse(body);\n\t\t} catch (error) {\n\t\t\tif (retries === 0 || String(error).includes('denied')) throw error;\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 1500));\n\t\t\treturn getJson(url, retries - 1);\n\t\t}\n\t}\n\n\t// ── Weather: current conditions, a 24h chart and a 4-day forecast\n\tconst CODES = {\n\t\t0: ['Clear', '☀️'], 1: ['Mostly clear', '🌤️'], 2: ['Partly cloudy', '⛅'], 3: ['Overcast', '☁️'],\n\t\t45: ['Fog', '🌫️'], 48: ['Fog', '🌫️'], 51: ['Drizzle', '🌦️'], 53: ['Drizzle', '🌦️'], 55: ['Drizzle', '🌦️'],\n\t\t61: ['Rain', '🌧️'], 63: ['Rain', '🌧️'], 65: ['Heavy rain', '🌧️'], 71: ['Snow', '🌨️'], 73: ['Snow', '🌨️'],\n\t\t75: ['Heavy snow', '❄️'], 80: ['Showers', '🌦️'], 81: ['Showers', '🌧️'], 82: ['Storm showers', '⛈️'],\n\t\t95: ['Thunderstorm', '⛈️'], 96: ['Thunderstorm', '⛈️'], 99: ['Thunderstorm', '⛈️']\n\t};\n\tconst describe = (code) => CODES[code] ?? [`Code ${code}`, '🌡️'];\n\tlet chart = null;\n\n\tasync function loadWeather(city) {\n\t\t$('weather-err').textContent = '';\n\t\ttry {\n\t\t\tconst geo = await getJson(\n\t\t\t\t`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1`\n\t\t\t);\n\t\t\tconst place = geo.results?.[0];\n\t\t\tif (!place) throw new Error(`${city} not found`);\n\t\t\tconst data = await getJson(\n\t\t\t\t`https://api.open-meteo.com/v1/forecast?latitude=${place.latitude}&longitude=${place.longitude}` +\n\t\t\t\t\t'&current=temperature_2m,weather_code&hourly=temperature_2m,precipitation_probability' +\n\t\t\t\t\t'&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=5&timezone=auto'\n\t\t\t);\n\t\t\t$('place').textContent = `${place.name}, ${place.country_code ?? ''}`;\n\t\t\tconst [text, icon] = describe(data.current.weather_code);\n\t\t\t$('now-temp').textContent = `${icon} ${Math.round(data.current.temperature_2m)}°`;\n\t\t\t$('now-text').textContent = text;\n\t\t\tdrawChart(data.hourly);\n\t\t\t$('forecast').replaceChildren(\n\t\t\t\t...data.daily.time.slice(1, 5).map((day, i) => {\n\t\t\t\t\tconst cell = document.createElement('div');\n\t\t\t\t\tconst [, dayIcon] = describe(data.daily.weather_code[i + 1]);\n\t\t\t\t\tconst name = new Date(day).toLocaleDateString([], { weekday: 'short' });\n\t\t\t\t\tcell.innerHTML = `<span class=\"muted\">${name}</span><b>${dayIcon}</b>${Math.round(\n\t\t\t\t\t\tdata.daily.temperature_2m_max[i + 1]\n\t\t\t\t\t)}° <span class=\"muted\">${Math.round(data.daily.temperature_2m_min[i + 1])}°</span>`;\n\t\t\t\t\treturn cell;\n\t\t\t\t})\n\t\t\t);\n\t\t} catch (error) {\n\t\t\t$('weather-err').textContent = String(error.message ?? error);\n\t\t}\n\t}\n\n\tfunction drawChart(hourly) {\n\t\tif (!window.Chart) return;\n\t\tconst start = hourly.time.findIndex((t) => new Date(t) >= new Date(Date.now() - 3600e3));\n\t\tconst slice = (list) => list.slice(start, start + 24);\n\t\tconst labels = slice(hourly.time).map((t) => `${new Date(t).getHours()}h`);\n\t\tconst ctx = $('chart').getContext('2d');\n\t\tconst fill = ctx.createLinearGradient(0, 0, 0, 160);\n\t\tfill.addColorStop(0, 'rgba(139, 92, 246, 0.45)');\n\t\tfill.addColorStop(1, 'rgba(139, 92, 246, 0)');\n\t\tchart?.destroy();\n\t\tchart = new Chart(ctx, {\n\t\t\tdata: {\n\t\t\t\tlabels,\n\t\t\t\tdatasets: [\n\t\t\t\t\t{\n\t\t\t\t\t\ttype: 'line',\n\t\t\t\t\t\tlabel: '°C',\n\t\t\t\t\t\tdata: slice(hourly.temperature_2m),\n\t\t\t\t\t\tborderColor: '#a78bfa',\n\t\t\t\t\t\tbackgroundColor: fill,\n\t\t\t\t\t\tfill: true,\n\t\t\t\t\t\ttension: 0.4,\n\t\t\t\t\t\tpointRadius: 0,\n\t\t\t\t\t\tyAxisID: 'temp'\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\ttype: 'bar',\n\t\t\t\t\t\tlabel: 'Rain %',\n\t\t\t\t\t\tdata: slice(hourly.precipitation_probability),\n\t\t\t\t\t\tbackgroundColor: 'rgba(34, 211, 238, 0.35)',\n\t\t\t\t\t\tborderRadius: 3,\n\t\t\t\t\t\tyAxisID: 'rain'\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t},\n\t\t\toptions: {\n\t\t\t\tresponsive: true,\n\t\t\t\tmaintainAspectRatio: false,\n\t\t\t\tanimation: { duration: 900, easing: 'easeOutQuart' },\n\t\t\t\tinteraction: { mode: 'index', intersect: false },\n\t\t\t\tplugins: { legend: { display: false } },\n\t\t\t\tscales: {\n\t\t\t\t\tx: { ticks: { color: '#94a3b8', maxTicksLimit: 8 }, grid: { display: false } },\n\t\t\t\t\ttemp: { position: 'left', ticks: { color: '#c4b5fd' }, grid: { color: 'rgba(255,255,255,0.06)' } },\n\t\t\t\t\train: { position: 'right', min: 0, max: 100, display: false }\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t}\n\n\t$('city').addEventListener('change', () => {\n\t\tconst city = $('city').value.trim();\n\t\tif (!city) return;\n\t\tstore.set('city', city);\n\t\tloadWeather(city);\n\t});\n\n\t// ── Focus timer: the end time is saved, so it keeps running across restarts\n\tconst FULL = 2 * Math.PI * 66;\n\t$('bar').style.strokeDasharray = FULL;\n\tlet timer = null;\n\n\tfunction renderTimer() {\n\t\tconst left = timer ? Math.max(0, timer.endsAt - Date.now()) : 25 * 60e3;\n\t\tconst total = timer ? timer.minutes * 60e3 : 25 * 60e3;\n\t\tconst secs = Math.ceil(left / 1000);\n\t\t$('left').textContent = `${String(Math.floor(secs / 60)).padStart(2, '0')}:${String(secs % 60).padStart(2, '0')}`;\n\t\t$('bar').style.strokeDashoffset = FULL * (1 - left / total);\n\t\tif (timer && left === 0) finishTimer();\n\t}\n\n\tasync function finishTimer() {\n\t\tif (timer.kind === 'focus') {\n\t\t\tconst today = new Date().toDateString();\n\t\t\tconst streak = (await store.get('streak')) ?? {};\n\t\t\tconst count = streak.day === today ? streak.count + 1 : 1;\n\t\t\tawait store.set('streak', { day: today, count });\n\t\t\trenderStreak(count);\n\t\t}\n\t\ttimer = null;\n\t\tstore.remove('timer');\n\t\trenderTimer();\n\t}\n\n\tfunction startTimer(minutes, kind) {\n\t\ttimer = { endsAt: Date.now() + minutes * 60e3, minutes, kind };\n\t\tstore.set('timer', timer);\n\t\trenderTimer();\n\t}\n\n\tfunction renderStreak(count) {\n\t\t$('streak').replaceChildren(\n\t\t\t...Array.from({ length: 8 }, (_, i) => {\n\t\t\t\tconst dot = document.createElement('i');\n\t\t\t\tif (i < count) dot.className = 'on';\n\t\t\t\treturn dot;\n\t\t\t})\n\t\t);\n\t}\n\n\t$('start').addEventListener('click', () => startTimer(25, 'focus'));\n\t$('short').addEventListener('click', () => startTimer(5, 'break'));\n\t$('stop').addEventListener('click', () => {\n\t\ttimer = null;\n\t\tstore.remove('timer');\n\t\trenderTimer();\n\t});\n\tsetInterval(renderTimer, 1000);\n\n\t// ── News: Hacker News top stories, links open in the browser\n\tlet newsLoadedAt = 0;\n\tasync function loadNews() {\n\t\tif (Date.now() - newsLoadedAt < 10 * 60e3) return;\n\t\tnewsLoadedAt = Date.now();\n\t\t$('news-err').textContent = '';\n\t\ttry {\n\t\t\tconst ids = (await getJson('https://hacker-news.firebaseio.com/v0/topstories.json')).slice(0, 12);\n\t\t\tconst stories = await Promise.all(\n\t\t\t\tids.map((id) => getJson(`https://hacker-news.firebaseio.com/v0/item/${id}.json`).catch(() => null))\n\t\t\t);\n\t\t\t$('stories').replaceChildren(\n\t\t\t\t...stories.filter(Boolean).map((story) => {\n\t\t\t\t\tconst link = document.createElement('a');\n\t\t\t\t\tlink.href = story.url ?? `https://news.ycombinator.com/item?id=${story.id}`;\n\t\t\t\t\tlink.innerHTML = '<span class=\"score\"></span><span class=\"title\"></span>';\n\t\t\t\t\tlink.querySelector('.score').textContent = `▲${story.score}`;\n\t\t\t\t\tlink.querySelector('.title').textContent = story.title;\n\t\t\t\t\tlink.title = story.title;\n\t\t\t\t\treturn link;\n\t\t\t\t})\n\t\t\t);\n\t\t} catch (error) {\n\t\t\tnewsLoadedAt = 0;\n\t\t\t$('news-err').textContent = String(error.message ?? error);\n\t\t}\n\t}\n\n\t// ── Notes: saved half a second after you stop typing\n\tlet noteTimer = 0;\n\tfunction saveNote() {\n\t\tclearTimeout(noteTimer);\n\t\tstore.set('note', $('note').value).then(() => ($('saved').textContent = 'Saved'));\n\t}\n\t$('note').addEventListener('input', () => {\n\t\t$('saved').textContent = 'Editing…';\n\t\tclearTimeout(noteTimer);\n\t\tnoteTimer = setTimeout(saveNote, 500);\n\t});\n\n\t// ── Restore everything that was saved\n\t(async () => {\n\t\tconst [tab, city, savedTimer, streak, note] = await Promise.all(\n\t\t\t['tab', 'city', 'timer', 'streak', 'note'].map((key) => store.get(key))\n\t\t);\n\t\t// A timer that ran out while Odeko was closed still counts.\n\t\ttimer = savedTimer;\n\t\trenderTimer();\n\t\trenderStreak(streak?.day === new Date().toDateString() ? streak.count : 0);\n\t\t$('note').value = note ?? '';\n\t\t$('city').value = city ?? 'Tokyo';\n\t\tshowTab(TABS.includes(tab) ? tab : 'weather');\n\t\tloadWeather($('city').value);\n\t\tsetInterval(() => loadWeather($('city').value), 30 * 60e3);\n\t})();\n</script>\n",
