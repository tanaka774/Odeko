		{
			"id": "sc-arcade-life",
			"name": "Custom HTML",
			"path": "",
			"icon_path": null,
			"icon_type": "widget",
			"widget_type": "custom",
			"widget_config": {
				"appearance": {
					"backgroundColor": "#000000",
					"backgroundOpacity": 0.82,
					"borderColor": "#f43f5e",
					"borderWidth": 3,
					"borderStyle": "double",
					"borderRadius": 0,
					"textColor": "#fef08a",
					"fontFamily": "'Press Start 2P', system-ui",
					"fontSize": 12,
					"shadowBlur": 0
				},
				"content": "<style>\n\tbody { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }\n\tcanvas { flex: 1; min-height: 0; width: 100%; cursor: crosshair; }\n\t.controls { display: flex; gap: 4px; justify-content: center; align-items: center; padding: 4px; }\n\tbutton { font: inherit; font-size: 0.8em; padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.25); background: rgba(255, 255, 255, 0.08); color: inherit; cursor: pointer; }\n\t#gen { font-size: 0.75em; opacity: 0.6; }\n</style>\n<canvas id=\"c\"></canvas>\n<div class=\"controls\">\n\t<button id=\"run\">Start/Stop</button>\n\t<button id=\"rand\">Random</button>\n\t<button id=\"clear\">Clear</button>\n\t<span id=\"gen\">gen 0</span>\n</div>\n<script>\n\t// The board is saved whenever you change it or stop the run, so your\n\t// pattern survives restarts. Click cells to toggle them.\n\tconst CELL = 6;\n\tconst canvas = document.getElementById('c');\n\tconst ctx = canvas.getContext('2d');\n\tlet cols = 0;\n\tlet rows = 0;\n\tlet grid = [];\n\tlet timer = null;\n\tlet gen = 0;\n\n\tconst blank = () => Array.from({ length: rows }, () => Array(cols).fill(0));\n\tconst setGen = (n) => {\n\t\tgen = n;\n\t\tdocument.getElementById('gen').textContent = `gen ${gen}`;\n\t};\n\tconst save = () => odeko.storage.set('board', { cols, rows, cells: grid.map((row) => row.join('')) });\n\n\tfunction fit(saved) {\n\t\tcanvas.width = canvas.clientWidth;\n\t\tcanvas.height = canvas.clientHeight;\n\t\tcols = Math.max(1, Math.floor(canvas.width / CELL));\n\t\trows = Math.max(1, Math.floor(canvas.height / CELL));\n\t\tconst old = grid;\n\t\tgrid = blank();\n\t\tconst source = saved ? saved.cells.map((row) => [...row].map(Number)) : old;\n\t\tfor (let y = 0; y < Math.min(rows, source.length); y++) {\n\t\t\tfor (let x = 0; x < Math.min(cols, source[y].length); x++) grid[y][x] = source[y][x];\n\t\t}\n\t\tdraw();\n\t}\n\n\tfunction neighbors(x, y) {\n\t\tlet n = 0;\n\t\tfor (let dy = -1; dy <= 1; dy++) {\n\t\t\tfor (let dx = -1; dx <= 1; dx++) {\n\t\t\t\tif (dx || dy) n += grid[(y + dy + rows) % rows][(x + dx + cols) % cols];\n\t\t\t}\n\t\t}\n\t\treturn n;\n\t}\n\n\tfunction step() {\n\t\tgrid = grid.map((row, y) =>\n\t\t\trow.map((cell, x) => {\n\t\t\t\tconst n = neighbors(x, y);\n\t\t\t\treturn cell ? (n === 2 || n === 3 ? 1 : 0) : n === 3 ? 1 : 0;\n\t\t\t})\n\t\t);\n\t\tsetGen(gen + 1);\n\t\tdraw();\n\t}\n\n\tfunction draw() {\n\t\tctx.clearRect(0, 0, canvas.width, canvas.height);\n\t\tctx.fillStyle = '#4ade80';\n\t\tfor (let y = 0; y < rows; y++) {\n\t\t\tfor (let x = 0; x < cols; x++) {\n\t\t\t\tif (grid[y][x]) ctx.fillRect(x * CELL + 1, y * CELL + 1, CELL - 2, CELL - 2);\n\t\t\t}\n\t\t}\n\t}\n\n\tfunction stop() {\n\t\tif (!timer) return;\n\t\tclearInterval(timer);\n\t\ttimer = null;\n\t\tsave();\n\t}\n\n\tdocument.getElementById('run').addEventListener('click', () => {\n\t\tif (timer) stop();\n\t\telse timer = setInterval(step, 120);\n\t});\n\tdocument.getElementById('rand').addEventListener('click', () => {\n\t\tstop();\n\t\tgrid = grid.map((row) => row.map(() => (Math.random() < 0.28 ? 1 : 0)));\n\t\tsetGen(0);\n\t\tdraw();\n\t\tsave();\n\t});\n\tdocument.getElementById('clear').addEventListener('click', () => {\n\t\tstop();\n\t\tgrid = blank();\n\t\tsetGen(0);\n\t\tdraw();\n\t\tsave();\n\t});\n\tcanvas.addEventListener('click', (event) => {\n\t\tconst rect = canvas.getBoundingClientRect();\n\t\tconst x = Math.floor((event.clientX - rect.left) / CELL);\n\t\tconst y = Math.floor((event.clientY - rect.top) / CELL);\n\t\tif (grid[y] && x < cols) {\n\t\t\tgrid[y][x] = grid[y][x] ? 0 : 1;\n\t\t\tdraw();\n\t\t\tsave();\n\t\t}\n\t});\n\twindow.addEventListener('resize', () => fit());\n\n\todeko.storage.get('board').then((saved) => {\n\t\tfit(saved);\n\t\tif (!saved) {\n\t\t\tconst cy = Math.floor(rows / 2);\n\t\t\tconst cx = Math.floor(cols / 2);\n\t\t\tfor (const [dy, dx] of [[0, 1], [1, 2], [2, 0], [2, 1], [2, 2]]) grid[cy + dy][cx + dx] = 1;\n\t\t\tdraw();\n\t\t}\n\t});\n</script>\n",
				"scripts": true,
				"file": null,
				"watch": false
			},
