		{
			"id": "sc-arcade-2048",
			"name": "Custom HTML",
			"path": "",
			"icon_path": null,
			"icon_type": "widget",
			"widget_type": "custom",
			"widget_config": {
				"appearance": {
					"backgroundColor": "#000000",
					"backgroundOpacity": 0.82,
					"borderColor": "#facc15",
					"borderWidth": 3,
					"borderStyle": "double",
					"borderRadius": 0,
					"textColor": "#fef08a",
					"fontFamily": "'Press Start 2P', system-ui",
					"fontSize": 12,
					"shadowBlur": 0
				},
				"content": "<!--\n\t2048: arrow keys or swipe. The board and best score are saved with\n\todeko.storage, so a game survives restarts.\n-->\n<style>\n\t:root {\n\t\t--board: rgba(255, 255, 255, 0.08);\n\t\t--empty: rgba(255, 255, 255, 0.06);\n\t}\n\t* {\n\t\tbox-sizing: border-box;\n\t}\n\tbody {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\theight: 100vh;\n\t\tpadding: 8px;\n\t\tgap: 6px;\n\t\tuser-select: none;\n\t\toutline: none;\n\t}\n\theader {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 8px;\n\t}\n\t.score {\n\t\tbackground: var(--board);\n\t\tborder-radius: 6px;\n\t\tpadding: 2px 8px;\n\t\tfont-size: 0.8em;\n\t\tfont-variant-numeric: tabular-nums;\n\t}\n\t.score b {\n\t\tfont-size: 1.15em;\n\t}\n\t#new {\n\t\tmargin-left: auto;\n\t\tfont: inherit;\n\t\tfont-size: 0.8em;\n\t\tpadding: 3px 10px;\n\t\tborder-radius: 6px;\n\t\tborder: none;\n\t\tbackground: #f59e0b;\n\t\tcolor: #1c1917;\n\t\tfont-weight: 700;\n\t\tcursor: pointer;\n\t}\n\t#board {\n\t\tflex: 1;\n\t\tmin-height: 0;\n\t\taspect-ratio: 1;\n\t\tmax-width: 100%;\n\t\tmargin: 0 auto;\n\t\tdisplay: grid;\n\t\tgrid-template-columns: repeat(4, 1fr);\n\t\tgap: 6px;\n\t\tpadding: 6px;\n\t\tbackground: var(--board);\n\t\tborder-radius: 10px;\n\t}\n\t.tile {\n\t\tdisplay: grid;\n\t\tplace-items: center;\n\t\tborder-radius: 6px;\n\t\tbackground: var(--empty);\n\t\tfont-weight: 800;\n\t\tfont-size: clamp(0.9em, 9vmin, 2.4em);\n\t\ttransition: background 0.1s;\n\t}\n\t#over {\n\t\ttext-align: center;\n\t\tfont-weight: 700;\n\t\tmin-height: 1.2em;\n\t}\n</style>\n<header>\n\t<div class=\"score\">Score <b id=\"score\">0</b></div>\n\t<div class=\"score\">Best <b id=\"best\">0</b></div>\n\t<button id=\"new\">New</button>\n</header>\n<div id=\"board\" tabindex=\"0\"></div>\n<div id=\"over\"></div>\n<script>\n\tconst COLORS = {\n\t\t2: '#eee4da',\n\t\t4: '#ede0c8',\n\t\t8: '#f2b179',\n\t\t16: '#f59563',\n\t\t32: '#f67c5f',\n\t\t64: '#f65e3b',\n\t\t128: '#edcf72',\n\t\t256: '#edcc61',\n\t\t512: '#edc850',\n\t\t1024: '#edc53f',\n\t\t2048: '#edc22e'\n\t};\n\tlet cells,\n\t\tscore,\n\t\tbest = 0;\n\n\tfunction spawn() {\n\t\tconst empty = cells.map((v, i) => (v ? -1 : i)).filter((i) => i >= 0);\n\t\tif (empty.length)\n\t\t\tcells[empty[Math.floor(Math.random() * empty.length)]] = Math.random() < 0.9 ? 2 : 4;\n\t}\n\n\tfunction reset() {\n\t\tcells = Array(16).fill(0);\n\t\tscore = 0;\n\t\tspawn();\n\t\tspawn();\n\t\tsave();\n\t\trender();\n\t}\n\n\tfunction save() {\n\t\tbest = Math.max(best, score);\n\t\todeko.storage.set('game', { cells, score, best });\n\t}\n\n\tfunction render() {\n\t\tdocument.getElementById('board').replaceChildren(\n\t\t\t...cells.map((v) => {\n\t\t\t\tconst tile = document.createElement('div');\n\t\t\t\ttile.className = 'tile';\n\t\t\t\tif (v) {\n\t\t\t\t\ttile.textContent = v;\n\t\t\t\t\ttile.style.background = COLORS[v] ?? '#3c3a32';\n\t\t\t\t\ttile.style.color = v <= 4 ? '#776e65' : '#f9f6f2';\n\t\t\t\t}\n\t\t\t\treturn tile;\n\t\t\t})\n\t\t);\n\t\tdocument.getElementById('score').textContent = score;\n\t\tdocument.getElementById('best').textContent = Math.max(best, score);\n\t\tdocument.getElementById('over').textContent = canMove()\n\t\t\t? cells.includes(2048)\n\t\t\t\t? 'You made 2048! 🎉'\n\t\t\t\t: ''\n\t\t\t: 'Game over';\n\t}\n\n\tfunction line(index, dir) {\n\t\tconst out = [];\n\t\tfor (let k = 0; k < 4; k++) {\n\t\t\tout.push(\n\t\t\t\tdir === 'left'\n\t\t\t\t\t? index * 4 + k\n\t\t\t\t\t: dir === 'right'\n\t\t\t\t\t\t? index * 4 + 3 - k\n\t\t\t\t\t\t: dir === 'up'\n\t\t\t\t\t\t\t? k * 4 + index\n\t\t\t\t\t\t\t: (3 - k) * 4 + index\n\t\t\t);\n\t\t}\n\t\treturn out;\n\t}\n\n\tfunction move(dir) {\n\t\tlet moved = false;\n\t\tfor (let i = 0; i < 4; i++) {\n\t\t\tconst idx = line(i, dir);\n\t\t\tconst values = idx.map((j) => cells[j]).filter(Boolean);\n\t\t\tconst merged = [];\n\t\t\twhile (values.length) {\n\t\t\t\tconst v = values.shift();\n\t\t\t\tif (values[0] === v) {\n\t\t\t\t\tmerged.push(v * 2);\n\t\t\t\t\tscore += v * 2;\n\t\t\t\t\tvalues.shift();\n\t\t\t\t} else merged.push(v);\n\t\t\t}\n\t\t\tidx.forEach((j, k) => {\n\t\t\t\tconst next = merged[k] ?? 0;\n\t\t\t\tif (cells[j] !== next) moved = true;\n\t\t\t\tcells[j] = next;\n\t\t\t});\n\t\t}\n\t\tif (moved) {\n\t\t\tspawn();\n\t\t\tsave();\n\t\t\trender();\n\t\t}\n\t}\n\n\tfunction canMove() {\n\t\tif (cells.includes(0)) return true;\n\t\tfor (let i = 0; i < 16; i++) {\n\t\t\tif (i % 4 < 3 && cells[i] === cells[i + 1]) return true;\n\t\t\tif (i < 12 && cells[i] === cells[i + 4]) return true;\n\t\t}\n\t\treturn false;\n\t}\n\n\tconst KEYS = {\n\t\tArrowLeft: 'left',\n\t\tArrowRight: 'right',\n\t\tArrowUp: 'up',\n\t\tArrowDown: 'down',\n\t\ta: 'left',\n\t\td: 'right',\n\t\tw: 'up',\n\t\ts: 'down'\n\t};\n\twindow.addEventListener('keydown', (event) => {\n\t\tconst dir = KEYS[event.key];\n\t\tif (!dir) return;\n\t\tevent.preventDefault();\n\t\tmove(dir);\n\t});\n\tlet start = null;\n\twindow.addEventListener('pointerdown', (e) => {\n\t\tstart = [e.clientX, e.clientY];\n\t\tdocument.getElementById('board').focus();\n\t});\n\twindow.addEventListener('pointerup', (e) => {\n\t\tif (!start) return;\n\t\tconst dx = e.clientX - start[0];\n\t\tconst dy = e.clientY - start[1];\n\t\tstart = null;\n\t\tif (Math.max(Math.abs(dx), Math.abs(dy)) < 24) return;\n\t\tmove(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : dy > 0 ? 'down' : 'up');\n\t});\n\tdocument.getElementById('new').addEventListener('click', reset);\n\n\todeko.storage.get('game').then((saved) => {\n\t\tif (saved?.cells?.length === 16) {\n\t\t\t({ cells, score, best } = saved);\n\t\t\trender();\n\t\t} else reset();\n\t});\n</script>\n",
