				"type": "html",
				"source": "<!doctype html><html><body style=\"margin:0;overflow:hidden\"><canvas></canvas><script>\nconst c=document.querySelector('canvas'),x=c.getContext('2d');let W=0,H=0,P=[];\nfunction sp(t){return{x:Math.random()*W,y:t?-20:Math.random()*H,r:5+Math.random()*7,a:Math.random()*6.28,s:20+Math.random()*30,w:Math.random()*6.28}}\nodeko.on('frame',st=>{if(st.width!==W||st.height!==H){W=c.width=st.width;H=c.height=st.height;P=Array.from({length:Math.round(W*H/22000)},()=>sp(false))}\nx.clearRect(0,0,W,H);for(const p of P){p.w+=0.02;p.a+=0.03;p.y+=p.s/60;p.x+=Math.sin(p.w)*0.8+0.4;const dx=p.x-st.pointer.x,dy=p.y-st.pointer.y,d=Math.hypot(dx,dy);if(d<120&&st.pointer.presence>0){p.x+=dx/d*2;p.y+=dy/d*2}\nif(p.y>H+20||p.x>W+20)Object.assign(p,sp(true));x.save();x.translate(p.x,p.y);x.rotate(p.a);x.fillStyle='rgba(255,183,213,0.85)';x.beginPath();x.ellipse(0,0,p.r,p.r*0.6,0,0,6.28);x.fill();x.restore()}});\n</script></body></html>",
