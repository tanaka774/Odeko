		{
			"id": "sc-sakura-custom-1",
			"name": "Custom HTML",
			"path": "",
			"icon_path": null,
			"icon_type": "widget",
			"widget_type": "custom",
			"widget_config": {
				"appearance": {
					"backgroundColor": "#fff1f5",
					"backgroundOpacity": 0.62,
					"backdropBlur": 16,
					"borderRadius": 28,
					"textColor": "#831843",
					"borderColor": "rgba(255,255,255,0.7)",
					"borderWidth": 1,
					"shadowBlur": 30,
					"shadowColor": "#be185d",
					"shadowOpacity": 0.18,
					"fontSize": 15
				},
				"content": "<!--\n\tCalendar: the current month, today highlighted. Arrows or the mouse wheel\n\tchange the month; click the title to come back to today.\n\tRecolor with the variables in :root.\n-->\n<style>\n\thtml { color-scheme: light; }\n\tbody { color: #831843; }\n\t:root {\n\t\t--accent: #f472b6;\n\t\t--muted: rgba(131, 24, 67, 0.45);\n\t\t--weekend: #be185d;\n\t}\n\t* {\n\t\tbox-sizing: border-box;\n\t}\n\tbody {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\theight: 100vh;\n\t\tpadding: 8px 10px;\n\t\tuser-select: none;\n\t}\n\theader {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: space-between;\n\t\tmargin-bottom: 4px;\n\t}\n\t#title {\n\t\tfont-weight: 700;\n\t\tfont-size: 1.1em;\n\t\tcursor: pointer;\n\t}\n\theader button {\n\t\tbackground: none;\n\t\tborder: none;\n\t\tcolor: inherit;\n\t\tfont: inherit;\n\t\tfont-size: 1.2em;\n\t\topacity: 0.6;\n\t\tcursor: pointer;\n\t\tpadding: 0 6px;\n\t}\n\theader button:hover {\n\t\topacity: 1;\n\t}\n\t#grid {\n\t\tflex: 1;\n\t\tdisplay: grid;\n\t\tgrid-template-columns: repeat(7, 1fr);\n\t\tgrid-auto-rows: 1fr;\n\t\ttext-align: center;\n\t\talign-items: center;\n\t}\n\t.dow {\n\t\tfont-size: 0.75em;\n\t\tcolor: var(--muted);\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 0.05em;\n\t}\n\t.day {\n\t\tfont-variant-numeric: tabular-nums;\n\t\tborder-radius: 999px;\n\t\taspect-ratio: 1;\n\t\tmax-height: 100%;\n\t\tmargin: auto;\n\t\tdisplay: grid;\n\t\tplace-items: center;\n\t\tmin-width: 1.9em;\n\t}\n\t.day.weekend {\n\t\tcolor: var(--weekend);\n\t}\n\t.day.other {\n\t\tcolor: var(--muted);\n\t\topacity: 0.5;\n\t}\n\t.day.today {\n\t\tbackground: var(--accent);\n\t\tcolor: #0b1020;\n\t\tfont-weight: 700;\n\t}\n</style>\n<header>\n\t<button id=\"prev\" aria-label=\"Previous month\">‹</button>\n\t<div id=\"title\" title=\"Back to today\"></div>\n\t<button id=\"next\" aria-label=\"Next month\">›</button>\n</header>\n<div id=\"grid\"></div>\n<script>\n\tconst MONDAY_FIRST = true;\n\tconst grid = document.getElementById('grid');\n\tlet shown = new Date();\n\tshown.setDate(1);\n\n\tfunction render() {\n\t\tconst today = new Date();\n\t\tconst year = shown.getFullYear();\n\t\tconst month = shown.getMonth();\n\t\tdocument.getElementById('title').textContent = shown.toLocaleDateString(undefined, {\n\t\t\tmonth: 'long',\n\t\t\tyear: 'numeric'\n\t\t});\n\t\tconst names = [];\n\t\tfor (let i = 0; i < 7; i++) {\n\t\t\tconst d = new Date(2024, 0, (MONDAY_FIRST ? 1 : 7) + i);\n\t\t\tnames.push(d.toLocaleDateString(undefined, { weekday: 'narrow' }));\n\t\t}\n\t\tconst cells = names.map((n) => `<div class=\"dow\">${n}</div>`);\n\t\tconst offset = (new Date(year, month, 1).getDay() + (MONDAY_FIRST ? 6 : 0)) % 7;\n\t\tconst start = new Date(year, month, 1 - offset);\n\t\tfor (let i = 0; i < 42; i++) {\n\t\t\tconst d = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);\n\t\t\tconst classes = ['day'];\n\t\t\tif (d.getMonth() !== month) classes.push('other');\n\t\t\tif (d.getDay() === 0 || d.getDay() === 6) classes.push('weekend');\n\t\t\tif (d.toDateString() === today.toDateString()) classes.push('today');\n\t\t\tcells.push(`<div class=\"${classes.join(' ')}\">${d.getDate()}</div>`);\n\t\t}\n\t\tgrid.innerHTML = cells.join('');\n\t}\n\n\tfunction move(step) {\n\t\tshown = new Date(shown.getFullYear(), shown.getMonth() + step, 1);\n\t\trender();\n\t}\n\n\tdocument.getElementById('prev').addEventListener('click', () => move(-1));\n\tdocument.getElementById('next').addEventListener('click', () => move(1));\n\tdocument.getElementById('title').addEventListener('click', () => {\n\t\tshown = new Date();\n\t\tshown.setDate(1);\n\t\trender();\n\t});\n\twindow.addEventListener('wheel', (event) => move(event.deltaY > 0 ? 1 : -1), { passive: true });\n\n\trender();\n\tlet lastDay = new Date().toDateString();\n\tsetInterval(() => {\n\t\tif (new Date().toDateString() !== lastDay) {\n\t\t\tlastDay = new Date().toDateString();\n\t\t\trender();\n\t\t}\n\t}, 60000);\n</script>\n",
