		{
			"id": "sc-cafe-pomodoro",
			"name": "Custom HTML",
			"path": "",
			"icon_path": null,
			"icon_type": "widget",
			"widget_type": "custom",
			"widget_config": {
				"appearance": {
					"backgroundColor": "#3b2618",
					"backgroundOpacity": 0.78,
					"backdropBlur": 12,
					"borderRadius": 18,
					"textColor": "#fbe9d0",
					"borderColor": "rgba(251, 233, 208, 0.2)",
					"borderWidth": 1,
					"shadowBlur": 24,
					"shadowOpacity": 0.35,
					"fontFamily": "Fraunces, system-ui",
					"fontSize": 20
				},
				"content": "<style>\n\tbody { font-family: Fraunces, serif; color: #fbe9d0; }\n\tbody { display: grid; place-content: center; gap: 8px; height: 100vh; text-align: center; }\n\t#time { font-size: 2.6em; font-weight: 700; font-variant-numeric: tabular-nums; }\n\t#done { font-size: 0.8em; opacity: 0.6; }\n\tbutton { font: inherit; font-size: 0.85em; padding: 4px 10px; margin: 0 2px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.25); background: rgba(255, 255, 255, 0.08); color: inherit; cursor: pointer; }\n</style>\n<div id=\"time\">25:00</div>\n<div>\n\t<button id=\"focus\">Focus</button>\n\t<button id=\"break\">Break</button>\n\t<button id=\"stop\">Stop</button>\n</div>\n<div id=\"done\"></div>\n<script>\n\t// The end time and the finished count are saved, so the timer keeps\n\t// running across reloads and restarts.\n\tconst timeEl = document.getElementById('time');\n\tconst doneEl = document.getElementById('done');\n\tlet endsAt = null;\n\tlet mode = 'focus';\n\tlet done = 0;\n\n\tfunction show(seconds) {\n\t\tconst m = String(Math.floor(seconds / 60)).padStart(2, '0');\n\t\tconst s = String(seconds % 60).padStart(2, '0');\n\t\ttimeEl.textContent = `${m}:${s}`;\n\t}\n\n\tfunction showDone() {\n\t\tdoneEl.textContent = `${done} focus session${done === 1 ? '' : 's'} today`;\n\t}\n\n\tfunction tick() {\n\t\tif (!endsAt) return;\n\t\tconst left = Math.max(0, Math.round((endsAt - Date.now()) / 1000));\n\t\tshow(left);\n\t\tif (left === 0) {\n\t\t\tif (mode === 'focus') {\n\t\t\t\tdone++;\n\t\t\t\todeko.storage.set('done', { day: new Date().toDateString(), count: done });\n\t\t\t\tshowDone();\n\t\t\t}\n\t\t\tstop();\n\t\t}\n\t}\n\n\tfunction start(minutes, nextMode) {\n\t\tmode = nextMode;\n\t\tendsAt = Date.now() + minutes * 60 * 1000;\n\t\todeko.storage.set('timer', { endsAt, mode });\n\t\ttick();\n\t}\n\n\tfunction stop() {\n\t\tendsAt = null;\n\t\todeko.storage.remove('timer');\n\t\tshow(25 * 60);\n\t}\n\n\tdocument.getElementById('focus').addEventListener('click', () => start(25, 'focus'));\n\tdocument.getElementById('break').addEventListener('click', () => start(5, 'break'));\n\tdocument.getElementById('stop').addEventListener('click', stop);\n\tsetInterval(tick, 1000);\n\n\t(async () => {\n\t\tconst timer = await odeko.storage.get('timer');\n\t\tif (timer && timer.endsAt > Date.now()) {\n\t\t\tendsAt = timer.endsAt;\n\t\t\tmode = timer.mode;\n\t\t}\n\t\tconst saved = await odeko.storage.get('done');\n\t\tdone = saved && saved.day === new Date().toDateString() ? saved.count : 0;\n\t\tshowDone();\n\t\ttick();\n\t})();\n</script>\n",
				"scripts": true,
				"file": null,
				"watch": false
			},
